# Ignore everything
/*
# Ignore junk files at any depth
.DS_Store
*.un~

# Allow specific config files
!.gitconfig
!.gitignore
!.markdownlint.jsonc
!.prettierrc.json
!.tmux.conf
!.vimrc
!.zshenv
!.zshrc
!README.md

# Allow folders of config files
# If folder includes some files that should still be ignored (e.g. .config), use this pattern:
#   !<DIR>/
#   <DIR>/*
#   !<DIR>/<ALLOWED_SUBDIR>
!.jb_cfg_utils/
.jb_cfg_utils/logs
!.jb_cfg_profiles
.jb_cfg_profiles/*
!.jb_cfg_profiles/default
!.config/
.config/*
!.config/backgrounds/
!.config/kitty/
.config/kitty/current-theme.conf
.config/kitty/kitty.conf.bak
!.config/lazygit/
.config/lazygit/theme.yml
!.config/nvim/
.config/nvim/lua/profile
!.config/starship.toml
!.config/stats/
